generator client {
  provider = "prisma-client-js"
}

// The actual connection (local file, or a hosted Turso database) is
// configured via the libSQL driver adapter in prisma.config.ts (CLI) and
// src/lib/db.ts (app runtime) — see .env.example. This `url` is an inert
// placeholder: Prisma's schema engine validates it against the `sqlite`
// provider's `file:` format at parse time even in adapter mode (before the
// adapter ever runs), so it can't be `env("DATABASE_URL")` — that var holds
// the real `libsql://...` target in production, which would fail this
// literal format check. A hardcoded dummy value sidesteps that.
datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

model QuizPack {
  id        String    @id @default(cuid())
  title     String
  prompt    String
  createdAt DateTime  @default(now())
  rounds    Round[]
  sessions  Session[]
  creator   Creator?  @relation(fields: [creatorId], references: [id])
  creatorId String?

  @@index([creatorId])
}

model Round {
  id        String     @id @default(cuid())
  pack      QuizPack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId    String
  index     Int
  title     String
  category  String
  questions Question[]

  @@unique([packId, index])
}

model Question {
  id      String @id @default(cuid())
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId String
  index   Int
  text    String
  answer  String
  points  Int    @default(1)
  // "TEXT" (default) or "MULTIPLE_CHOICE". A MULTIPLE_CHOICE question stores
  // its choices as a JSON-encoded string[] in `options` (see
  // src/lib/question-types.ts) rather than a separate table — SQLite has no
  // native array/JSON column, and nothing here queries inside the list.
  // TEXT questions leave `options` null.
  type    String  @default("TEXT")
  options String?
  // Alternate spellings/nicknames/etc. the host has approved as also-correct
  // (e.g. "7" alongside "Seven"), checked by isLikelyCorrect in
  // src/lib/scoring.ts. Same JSON-encoded string[] storage as `options`
  // (parsed with the same helpers in src/lib/question-types.ts); null/empty
  // means only the primary `answer` scores as correct.
  acceptableAnswers String?
  // Optional image shown with the question (see src/lib/media.ts). Kept in a
  // separate table so pack reads never carry image bytes — the pack payload
  // exposes only `hasMedia`.
  media   QuestionMedia?

  @@unique([roundId, index])
}

// An image uploaded by the pack's owner for one question. The bytes live
// here rather than at a remote URL on purpose: every surface that renders a
// question image reads them from this row, so no render path ever makes a
// network request. That is what keeps @react-pdf/renderer's server-side
// <Image src> resolution (a bare `fetch`, no scheme/host/size/timeout
// limits) from becoming an SSRF hole reachable through the unauthenticated
// PDF route. See the "Media support" section of HANDOFF.md.
model QuestionMedia {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String   @unique
  // Always derived from the uploaded bytes' magic number, never from the
  // request's Content-Type or a filename. "image/jpeg" | "image/png".
  mime       String
  bytes      Bytes
  byteSize   Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  // Replacing an image reuses the row, so this is what tells a cached copy
  // apart from a new one — it is the ETag the serve route revalidates on.
  updatedAt  DateTime @updatedAt
}

model Session {
  id                      String    @id @default(cuid())
  pack                    QuizPack  @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId                  String
  code                    String    @unique
  hostToken               String    @unique
  status                  String    @default("LOBBY") // LOBBY | QUESTION_ACTIVE | REVEAL | ENDED
  currentRoundIndex       Int       @default(0)
  currentQuestionIndex    Int       @default(0)
  // Per-question countdown, set by the host at session creation (see
  // POST /api/sessions). Both null means "no timer — manual reveal only".
  // questionStartedAt is stamped fresh every time a question goes QUESTION_ACTIVE
  // (advance's "start"/"next") so the countdown restarts each question.
  questionDurationSeconds Int?
  questionStartedAt       DateTime?
  createdAt               DateTime  @default(now())
  teams                   Team[]
  answers                 Answer[]
}

model Team {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  name      String
  token     String   @unique
  createdAt DateTime @default(now())
  answers   Answer[]

  @@unique([sessionId, name])
}

model Answer {
  id            String   @id @default(cuid())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  roundIndex    Int
  questionIndex Int
  text          String
  isCorrect     Boolean?
  pointsAwarded Int      @default(0)
  submittedAt   DateTime @default(now())

  @@unique([teamId, roundIndex, questionIndex])
}

model Creator {
  id                     String     @id @default(cuid())
  deviceKey              String     @unique
  plan                   String     @default("FREE") // FREE | PRO
  packsGeneratedInPeriod Int        @default(0)
  periodStartedAt        DateTime   @default(now())
  createdAt              DateTime   @default(now())
  packs                  QuizPack[]

  // Set by the Paddle webhook (src/lib/paddle/apply-subscription.ts) and
  // the restore flow. Never written from the browser.
  email                  String?    @unique
  paddleCustomerId       String?
  paddleSubscriptionId   String?    @unique
  subscriptionStatus     String?    // Paddle SubscriptionStatus
  subscriptionUpdatedAt  DateTime?  // occurred_at of the last applied event
  restoreTokens          RestoreToken[]
}

// One row per Paddle webhook delivery. Primary key on Paddle's event_id
// makes the webhook idempotent: a retry hits the unique constraint and is
// acknowledged without re-applying.
model PaddleEvent {
  eventId    String   @id
  type       String
  occurredAt DateTime
  receivedAt DateTime @default(now())
}

// Single-use magic-link tokens for /restore. Only the SHA-256 of the token
// is stored; the raw token travels in the email link.
model RestoreToken {
  tokenHash String    @id
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([creatorId])
}
